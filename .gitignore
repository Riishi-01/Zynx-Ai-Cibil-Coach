# Environment variables
.env
.env*.local

# Virtual environment
.venv/
venv/
env/
ENV/

# Python cache & build outputs
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
