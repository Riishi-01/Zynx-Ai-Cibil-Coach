*.egg

# Database
# The .db file is generated — rebuild it with scripts/seed_db.py + seed_kb.py.
# The seed fixtures in build_docs/ are tracked deliberately: they are the only
# source of the synthetic customer data, so they must never be gitignored.
*.db
*.sqlite3
cibil_coach.db
!build_docs/cibil_data.json

# OS specific files
.DS_Store
Thumbs.db

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Documentation / Ignored Folders
Frontend_docs/

# Data export for one-shot Supabase migration. Regenerated by
# scripts/export_sqlite_to_supabase.py. Contains PII (masked PANs, names,
# balances) — never commit.
data/supabase_seed.json

# Vercel deploy artifacts (the .vercel/ folder holds project metadata
# including a project ID and deployment cache — created locally by `vercel`
# CLI; harmless to regenerate).
.vercel/


# =============================================================================
# Production-branch exclusions
#
# The following files are local-dev only and irrelevant to the Vercel
# deployment that this branch ships. They remain tracked on `main` (where
# they're needed for `scripts/seed_db.py` and local SQLite migration), but
# are ignored here so the production commit stays focused on deploy changes.
# =============================================================================

# Source fixture for SQLite seeding — only used by scripts/seed_db.py on
# local dev. The migrated data lives in Supabase.
build_docs/

# Local-dev launcher (uvicorn on :8000). Vercel uses api/index.py + vercel.json
# instead, so this script is not exercised in production.
run_web.sh

# Alembic config for SQLite local-dev migrations. Postgres schema is created
# out-of-band via docs/supabase_schema.sql, never via alembic on Vercel.
alembic.ini
alembic/

# Local-dev contribution guide. Docs/DEPLOYMENT.md is the production runbook
# and replaces this in the Vercel-deploy context.
CONTRIBUTING.md

