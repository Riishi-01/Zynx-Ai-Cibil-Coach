# =============================================================================
# CIBIL Credit Coach — environment variables
#
# Local dev reads this file via python-dotenv (loaded by app/config.py).
# Vercel reads these from the project's Environment Variables settings page;
# never paste real secrets into .env.example or commit them to git.
#
# Two deployment modes:
#   1. Local dev (default)  → SQLite, reads cibil_coach.db, no Supabase needed.
#   2. Production (Vercel)  → Postgres/Supabase, requires DATABASE_URL +
#      Supabase keys + OpenAI + (optional) LangSmith + (Phase 2) Turnstile.
# =============================================================================


# =============================================================================
# LLM — required everywhere
# =============================================================================

# OpenAI API key. Used by app/llm_stream.py for gpt-4o-mini.
OPENAI_API_KEY=sk-...


# =============================================================================
# Database — choose one
# =============================================================================

# Default (local dev): SQLite file in the repo root. No DATABASE_URL needed.
# DATABASE_URL=sqlite:///./cibil_coach.db

# Production (Vercel): Postgres. Use the Supabase connection string from
# Settings → Database → Connection string → URI (Direct connection, not pooler).
# Format: postgresql://postgres:<password>@<host>:<port>/postgres
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres


# =============================================================================
# Supabase — required for production
# =============================================================================

# Project URL — from Supabase Settings → API → Project URL.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service role key (SECRET — never expose to the frontend). From Settings → API.
# Used by app/supabase_repository.py and app/kb_loader.py to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anon public key (safe to expose — used with RLS). Mirror as VITE_SUPABASE_ANON_KEY
# for the frontend.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# =============================================================================
# Frontend (VITE_* — bundled into the JS, public)
# =============================================================================

# Mirrors of the Supabase vars above, exposed to the browser.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cloudflare Turnstile site key. Phase 2 only — leave unset for the first deploy.
# Get from dash.cloudflare.com → Turnstile → Add Site after the Vercel URL is live.
VITE_TURNSTILE_SITE_KEY=


# =============================================================================
# Cloudflare Turnstile — Phase 2 only
# =============================================================================

# Secret key for server-side verification. Same source as VITE_TURNSTILE_SITE_KEY.
# Leave unset for Phase 1; verify_turnstile() will short-circuit to True.
TURNSTILE_SECRET_KEY=


# =============================================================================
# LangSmith — optional observability for LLM calls
# =============================================================================

# Get from smith.langchain.com → Settings → API Keys.
LANGSMITH_API_KEY=lsv2_pt_...

# Project name shown in smith.langchain.com. Default: cibil-coach.
LANGSMITH_PROJECT=cibil-coach